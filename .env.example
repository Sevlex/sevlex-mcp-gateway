# ==============================================================================
# SEVLEX ENTERPRISE CONFIGURATION TEMPLATE (.env.example)
# Zero-Trust Model Context Protocol (MCP) Layer 7 Security Gateway
# ==============================================================================

# Authentication & SecOps Clearance
ADMIN_API_KEY=sevlex_secret_123

# Network Port Bindings
GATEWAY_PORT=8080
DASHBOARD_PORT=3000

# ------------------------------------------------------------------------------
# Production Database: PostgreSQL (AWS RDS in Customer VPC or Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://sevlex:sevlex_secret_pwd@localhost:5432/sevlex
DATABASE_SSL=false

# Local Offline Dev Storage (when running standalone without Docker or RDS)
SEVLEX_DB_PATH=/data/audit_log.db
SEVLEX_POLICY_PATH=/data/sevlex.json
SEVLEX_DISCOVERED_TOOLS_PATH=/data/discovered_tools.json

# Enterprise Incident Alerting & SIEM Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SEVLEX_SIEM_PROVIDER=datadog
SEVLEX_SIEM_ENDPOINT=https://http-intake.logs.us5.datadoghq.com/api/v2/logs

# GitHub App Integration (SSO & Repo Governance)
GITHUB_APP_ID=5450898
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
