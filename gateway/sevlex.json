{
  "version": "1.0",
  "policy": {
    "defaultAction": "ALLOW",
    "blockedTools": [
      "execute_arbitrary_shell",
      "drop_tables"
    ],
    "approvalRequiredTools": [
      "github_list_pull_requests",
      "codemode_execute",
      "execute"
    ],
    "parameterRules": {
      "enabled": true
    },
    "dlp": {
      "enabled": true
    },
    "siem": {
      "enabled": true,
      "provider": "datadog",
      "endpoint": "https://http-intake.logs.us5.datadoghq.com/api/v2/logs",
      "apiKey": "YOUR_DATADOG_API_KEY_HERE"
    }
  }
}