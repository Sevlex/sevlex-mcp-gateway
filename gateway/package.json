{
  "name": "sevlex",
  "version": "1.0.0",
  "description": "Layer 7 Zero-Trust Security Gateway & Control Plane for the Model Context Protocol (MCP)",
  "main": "dist/gateway.js",
  "module": "dist/gateway.js",
  "types": "dist/gateway.d.ts",
  "bin": {
    "sevlex": "./bin/sevlex.js"
  },
  "files": [
    "dist",
    "bin",
    "sevlex.json",
    "discovered_tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run test",
    "start": "node dist/gateway.js",
    "dev": "node --import tsx src/gateway.ts",
    "simulate": "node --import tsx scripts/live_e2e_simulation.ts",
    "stress": "node --import tsx scripts/stress_5000.ts",
    "test": "node --import tsx scripts/live_e2e_simulation.ts",
    "verify": "node bin/sevlex.js verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zero-trust",
    "gateway",
    "firewall",
    "security",
    "ai-security",
    "ai-agent",
    "claude",
    "cursor"
  ],
  "author": "Sevlex Authors",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meetpanchal-sevlex/sevlex-mcp-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/meetpanchal-sevlex/sevlex-mcp-gateway/issues"
  },
  "homepage": "https://github.com/meetpanchal-sevlex/sevlex-mcp-gateway#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@supabase/supabase-js": "^2.104.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}
